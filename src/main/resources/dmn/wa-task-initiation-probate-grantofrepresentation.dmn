      <input id="InputClause_03ia619" label="Create Task">
        <inputExpression id="LiteralExpression_133p7cx" typeRef="boolean">
          <text>if(additionalData != null and additionalData.Data != null and additionalData.Data.createTask != null) then additionalData.Data.createTask else false</text>
