      <input id="InputClause_03i3ghi" label="evidenceHandled" biodi:width="291" camunda:inputVariable="evidenceHandled">
        <inputExpression id="LiteralExpression_0kx1xp4" typeRef="boolean">
          <text>if(additionalData != null and additionalData.Data != null and
            additionalData.Data.evidenceHandled
            != null) then
            additionalData.Data.evidenceHandled
            else
            false
          </text>
        </inputExpression>
      </input>
      <input id="InputClause_0igjxpg" label="caseType" biodi:width="291" camunda:inputVariable="caseType">
        <inputExpression id="LiteralExpression_176w5mt" typeRef="string">
          <text>if(additionalData != null and additionalData.Data.caseType
  != null) then
  additionalData.Data.caseType
  else
  ""
          </text>
        </inputExpression>
        <inputValues id="UnaryTests_0s5s50h">
          <text>"gop","admonWill","intestacy","adColligendaBona"</text>
        </inputValues>
      </input>
      <input id="InputClause_0ts4kea" label="boHandoffReasonPresent" camunda:inputVariable="boHandoffReasonPresent">
        <inputExpression id="LiteralExpression_1l94sjj" typeRef="boolean">
          <text>if(additionalData != null and additionalData.Data != null and
            additionalData.Data.boHandoffReasonList != null and
count(list: additionalData.Data.boHandoffReasonList) &gt; 0) then
            true else false</text>
        </inputExpression>
